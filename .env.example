# ---------------------------------------------------------------------------
# polymarket-bot configuration. Copy to `.env` and edit.
#
#   cp .env.example .env
#
# Every setting is optional: the defaults below are the defaults the bot uses
# when the variable is absent. Paper mode needs no credentials at all.
# ---------------------------------------------------------------------------

# --- Mode ------------------------------------------------------------------
# paper = simulate fills locally, no keys, no money. live = real orders.
POLYMARKET_BOT_MODE=paper

# --- Credentials (live mode only) ------------------------------------------
# NEVER commit your real .env. The bot refuses to start live without a key.
# POLYMARKET_PRIVATE_KEY=0x...
# The Polymarket proxy/deposit wallet that holds USDC (required for live).
# POLYMARKET_DEPOSIT_WALLET=0x...
# 0 = EOA, 1 = email/magic proxy (default), 2 = browser wallet proxy.
# POLYMARKET_SIGNATURE_TYPE=1
# Optional: supply existing API creds instead of deriving them on startup.
# POLYMARKET_CLOB_API_KEY=
# POLYMARKET_CLOB_API_SECRET=
# POLYMARKET_CLOB_API_PASSPHRASE=

# --- Scan loop -------------------------------------------------------------
POLYMARKET_BOT_SCAN_LIMIT=100
POLYMARKET_BOT_MAX_MARKETS_PER_CYCLE=60
POLYMARKET_BOT_POLL_INTERVAL_S=20
POLYMARKET_BOT_REQUEST_TIMEOUT=10
POLYMARKET_BOT_MAX_RETRIES=3

# --- Strategy 1: complete-set arbitrage (binary Yes+No < $1) ---------------
POLYMARKET_BOT_ARB_ENABLED=true
# Minimum net edge per $1 set, after fees. 0.02 = 2 cents.
POLYMARKET_BOT_ARB_MIN_EDGE=0.02
# Sanity ceiling: a bigger "edge" is a broken book, not free money.
POLYMARKET_BOT_ARB_MAX_EDGE=0.15
# Reject markets whose bid/ask spread is wider than this.
POLYMARKET_BOT_ARB_MAX_SPREAD=0.05
POLYMARKET_BOT_ARB_MIN_VOLUME24H=10000
POLYMARKET_BOT_ARB_MIN_LIQUIDITY=5000
POLYMARKET_BOT_ARB_MIN_TOP_SIZE=100
POLYMARKET_BOT_ARB_MIN_SECONDS_LEFT=600
POLYMARKET_BOT_ARB_MAX_SECONDS_LEFT=604800
# Per-market cooldown after a fill, and the spike size that counts as chasing.
POLYMARKET_BOT_ARB_COOLDOWN_S=60
POLYMARKET_BOT_ARB_ANTICHASE_SPIKE=0.08

# --- Strategy 2: basket arbitrage (neg-risk outcome set < $1) --------------
POLYMARKET_BOT_BASKET_ENABLED=true
POLYMARKET_BOT_BASKET_MIN_EDGE=0.015
POLYMARKET_BOT_BASKET_MAX_EDGE=0.25
# Reject a set whose prices sum far below 1 (data problem, not an edge).
POLYMARKET_BOT_BASKET_MAX_DISLOCATION=0.15
POLYMARKET_BOT_BASKET_MIN_OUTCOMES=3
POLYMARKET_BOT_BASKET_MAX_OUTCOMES=12
POLYMARKET_BOT_BASKET_MIN_VOLUME24H=25000
POLYMARKET_BOT_BASKET_MIN_LIQUIDITY=10000
POLYMARKET_BOT_BASKET_MIN_TOP_SIZE=25
POLYMARKET_BOT_BASKET_MIN_SECONDS_LEFT=3600

# --- Strategy 3: fade extreme (DIRECTIONAL, disabled by default) -----------
# This is NOT risk-free. Its edge is an assumption, not an arbitrage. Read
# the README before enabling it.
POLYMARKET_BOT_FADE_ENABLED=false
POLYMARKET_BOT_FADE_BELOW=0.05
POLYMARKET_BOT_FADE_MAX_ENTRY=0.06
POLYMARKET_BOT_FADE_MIN_VOLUME24H=50000
POLYMARKET_BOT_FADE_MIN_TOP_SIZE=250
POLYMARKET_BOT_FADE_MIN_SECONDS_LEFT=3600
# How far back toward 0.50 a faded price is assumed to travel (0.10 = 10%).
POLYMARKET_BOT_FADE_REVERSION_ALPHA=0.10
# Minimum net edge per set after the round-trip spread and both fees.
POLYMARKET_BOT_FADE_MIN_EDGE=0.01
# Largest round-trip cost (spread + both fees) tolerated, as a fraction of the
# entry price. On a 2c market a single unmoved tick is already more than the
# stop-loss allows, so without this the bot opens a position that is stopped
# out next cycle with the book unmoved. 0 disables the gate.
POLYMARKET_BOT_FADE_MAX_ROUND_TRIP_RATIO=0.25

# --- Cross-market threshold ladders ---------------------------------------
# Off by default. The relation between the two legs is inferred from question
# wording, so it is a guess rather than a protocol guarantee. In paper mode an
# unconfirmed pair may be priced; in live mode a pair must be named in
# POLYMARKET_BOT_CROSS_MARKET_CONFIRMED_PAIRS or it is refused.
POLYMARKET_BOT_CROSS_MARKET_ENABLED=false
POLYMARKET_BOT_CROSS_MARKET_MIN_EDGE=0.02
POLYMARKET_BOT_CROSS_MARKET_MAX_EDGE=0.15
# Per-leg book spread is capped by POLYMARKET_BOT_ARB_MAX_SPREAD (above).
POLYMARKET_BOT_CROSS_MARKET_MIN_VOLUME24H=25000
POLYMARKET_BOT_CROSS_MARKET_MIN_LIQUIDITY=10000
POLYMARKET_BOT_CROSS_MARKET_MIN_TOP_SIZE=100
POLYMARKET_BOT_CROSS_MARKET_MIN_SECONDS_LEFT=3600
# Gamma caps a page at 100 rows; ladder markets are not top-of-volume.
POLYMARKET_BOT_CROSS_MARKET_SCAN_PAGES=3
# Comma- or semicolon-separated "CONDITION_ID:CONDITION_ID" pairs (either
# order). Discover candidates with `python run.py ladders`, then open both
# markets and confirm the resolution rules agree before listing a pair.
# Empty means live mode will not trade any ladder.
POLYMARKET_BOT_CROSS_MARKET_CONFIRMED_PAIRS=

# --- Exits -----------------------------------------------------------------
# Master switch for take-profit, stop-loss, and settlement handling.
POLYMARKET_BOT_EXITS_ENABLED=true
# Sell once the net liquidation value clears entry cost by this fraction.
POLYMARKET_BOT_TAKE_PROFIT_PCT=0.15
# Sell once the net liquidation value falls this fraction below entry cost.
POLYMARKET_BOT_STOP_LOSS_PCT=0.30
# Cap exposure shared by correlated markets (e.g. several "Iran by September"
# questions). 0 disables the correlation cap. Markets whose event tag cannot be
# resolved still share one bucket, keyed by event id, so a failed lookup can
# never uncap a correlated cluster.
POLYMARKET_BOT_MAX_THEME_EXPOSURE_USD=150
# After a stop-loss, refuse to re-buy the same market for this many seconds.
# The exit pass runs before entry, so without this a stopped position frees its
# slot and the identical signal is re-opened on the very next line. 0 disables.
POLYMARKET_BOT_REENTRY_COOLDOWN_S=900

# --- Risk limits -----------------------------------------------------------
POLYMARKET_BOT_MAX_ORDER_USD=100
POLYMARKET_BOT_MAX_TOTAL_EXPOSURE_USD=500
POLYMARKET_BOT_MAX_OPEN_POSITIONS=8
POLYMARKET_BOT_MAX_ORDERS_PER_MIN=10
# Keep this much cash unspent at all times.
POLYMARKET_BOT_MIN_FREE_BALANCE_USD=20
# Shrink any size whose average fill strays this far above the touch price.
POLYMARKET_BOT_MAX_BOOK_IMPACT=0.03
# Panic button: detect opportunities but never place an order.
POLYMARKET_BOT_KILL_SWITCH=false

# --- Fees ------------------------------------------------------------------
# 0 = use the per-market rate reported by the CLOB (recommended).
POLYMARKET_BOT_TAKER_FEE_RATE=0
# True = model legs as resting maker orders (zero taker fee).
POLYMARKET_BOT_ASSUME_MAKER=false
# Multiply every modelled fee by this to leave headroom (1.25 = +25%).
POLYMARKET_BOT_FEE_SAFETY_MULTIPLIER=1.0

# --- Paper portfolio -------------------------------------------------------
POLYMARKET_BOT_PAPER_BALANCE=1000
# Optional: write the ledger to this path on shutdown.
# POLYMARKET_BOT_STATE_FILE=state/portfolio.json

# --- Live execution --------------------------------------------------------
# Extra price allowed on a market order, as a fraction of the quoted price.
POLYMARKET_BOT_LIVE_MAX_SLIPPAGE=0.005
# FAK (fill-and-kill, partial ok) or FOK (fill-or-kill, all or nothing).
POLYMARKET_BOT_LIVE_ORDER_TYPE=FAK

# --- Endpoints (override only if you proxy the API) ------------------------
# POLYMARKET_BOT_GAMMA_HOST=https://gamma-api.polymarket.com
# POLYMARKET_BOT_CLOB_HOST=https://clob.polymarket.com

# --- Logging ---------------------------------------------------------------
POLYMARKET_BOT_LOG_LEVEL=INFO
# POLYMARKET_BOT_LOG_FILE=state/bot.log
POLYMARKET_BOT_LOG_JSON=false
